{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false,
    "resolveJsonModule": true,
    "paths": {
      "~project-sesame/client/*": ["./src/client/*"],
      "~project-sesame/server/*": ["./src/server/*"],
      "~project-sesame/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/types.d.ts", "**/*.ts"],
  "exclude": [
    ".worktree/**/*",
    "dist/**/*",
    "node_modules/**/*",
    "coverage/**/*"
  ]
}
